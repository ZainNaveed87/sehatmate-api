NODE_ENV=production
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=your_mysql_database
DB_USER=your_mysql_user
DB_PASSWORD=replace_with_mysql_password
DB_CONNECTION_LIMIT=10

JWT_SECRET=replace_with_a_long_random_secret_of_at_least_32_characters
JWT_EXPIRES_IN=7d

# Comma-separated HTTPS origins for Flutter Web. Native Android/iOS calls have no browser origin.
CLIENT_ORIGINS=https://your-app-domain.com
